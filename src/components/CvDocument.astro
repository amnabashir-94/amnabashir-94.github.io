---
/**
 * The on-page CV, and the source the CV PDF is printed from.
 *
 * Draws the model from `cv-model.ts`, the same one `cv-markdown.ts` draws for the DOCX, so the
 * page, the PDF and the Word file make the same claims in the same order. Printing from real
 * HTML also yields a text-based PDF — readable by parsers — rather than the flattened image a
 * design tool exports, which is what her previous CV was.
 */
import { buildCv } from '../lib/cv-model';
import { loadProfile } from '../lib/profile';
import type { Variant } from '../schema/profile';

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const cv = buildCv(loadProfile(), variant);
---

<article class="cv">
  <header class="cv__head">
    <h1 class="cv__name">{cv.name}</h1>
    <p class="cv__title">{cv.headline}</p>
    <p class="cv__contact">{cv.contact.join('  ·  ')}</p>
  </header>

  {
    cv.sections.map((section) => (
      <section class="cv__section">
        <h2>{section.title}</h2>
        {section.type === 'paragraph' && <p class="cv__plain">{section.text}</p>}
        {section.type === 'list' && (
          <ul class="cv__list">
            {section.lines.map((l) => (
              <li>
                {l.lead && <strong>{l.lead}</strong>} {l.text}
                {l.detail && (
                  <>
                    <br />
                    <span class="cv__detail">{l.detail}</span>
                  </>
                )}
              </li>
            ))}
          </ul>
        )}
        {section.type === 'roles' &&
          section.roles.map((role) => (
            <div class="cv__role">
              <h3>{role.title}</h3>
              <p class="cv__meta">{role.meta.replaceAll(' | ', ' · ')}</p>
              <ul class="cv__list">
                {role.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
      </section>
    ))
  }
</article>

<style>
  .cv {
    max-width: 48rem;
  }

  .cv__head {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .cv__name {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.6rem);
    margin: 0 0 0.15rem;
  }

  .cv__title {
    font-size: 1rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  .cv__contact {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .cv__section {
    margin-bottom: 1.6rem;
  }

  .cv__section h2 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.3rem;
    margin-bottom: 0.85rem;
  }

  .cv__role {
    margin-bottom: 1.3rem;
  }
  .cv__role h3 {
    font-size: 1.05rem;
    margin: 0 0 0.1rem;
  }

  .cv__meta {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0 0 0.5rem;
  }

  .cv__list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.97rem;
  }
  .cv__list li {
    margin-bottom: 0.4rem;
  }
  .cv__detail {
    color: var(--ink-muted);
    font-size: 0.92em;
  }
  .cv__plain {
    font-size: 0.97rem;
  }

  /*
   * Never strand a heading at the foot of a page. Whole sections cannot be kept together —
   * a long Experience section would leave half a blank page — so the rule is applied to the
   * units that are short: a role, a list item, and a heading with what follows it.
   */
  @media print {
    .cv {
      max-width: none;
    }
    .cv__section h2 {
      break-after: avoid;
    }
    .cv__role,
    .cv__list li,
    .cv__section:has(> .cv__plain) {
      break-inside: avoid;
    }
  }
</style>
