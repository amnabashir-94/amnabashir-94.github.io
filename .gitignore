# Dependencies
node_modules/

# Build output
dist/
.astro/
# Intermediate CV Markdown; the DOCX and PDF it produces are committed under public/.
build/
# Review screenshots from `npm run shots`.
shots/
# Placeholder images for the layout fixture; regenerated by scripts/make-sample-images.ts.
src/assets/sample/
# Generated working documents (intake sheet, applications pack): they record gaps and
# disagreements between sources, which do not belong in a public repository.
private/

# Environment
.env
.env.*
!.env.example

# Secrets — never tracked, in any form
*.pem
*.key
*.b64

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
